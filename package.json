{
  "name": "themes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Temas sazonais do ecossistema Tudo em Código: manifesto JSON fechado, validado por esquema e contraste.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "validate": "node scripts/validate-cli.mjs",
